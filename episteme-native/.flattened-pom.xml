<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.episteme-hpc</groupId>
    <artifactId>episteme-parent</artifactId>
    <version>1.0.0-beta3.0.17</version>
  </parent>
  <artifactId>episteme-native</artifactId>
  <version>1.0.0-beta3.0.17</version>
  <name>Episteme Native</name>
  <description>Native library integration via Project Panama (FFM API)</description>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <properties>
    <la.native.exclude.1>**/NativeCUDA*LinearAlgebra*Backend.java</la.native.exclude.1>
    <cuda.exclude.3>**/_NONE_/**</cuda.exclude.3>
    <cuda.exclude.1>**/_NONE_/**</cuda.exclude.1>
    <cuda.exclude.2>**/_NONE_/**</cuda.exclude.2>
    <la.native.exclude.2>**/NativeOpenCL*LinearAlgebra*Backend.java</la.native.exclude.2>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.github.episteme-hpc</groupId>
      <artifactId>episteme-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.episteme-hpc</groupId>
      <artifactId>episteme-natural</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
    </dependency>
    <dependency>
      <groupId>org.deeplearning4j</groupId>
      <artifactId>deeplearning4j-core</artifactId>
      <version>1.0.0-M2.1</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j2-impl</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.nd4j</groupId>
      <artifactId>nd4j-api</artifactId>
      <version>${nd4j.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j-impl</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j2-impl</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.nd4j</groupId>
      <artifactId>nd4j-native-platform</artifactId>
      <version>${nd4j.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j-impl</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j2-impl</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>arrow</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jocl</groupId>
      <artifactId>jocl</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>fftw</artifactId>
      <version>3.3.10-${javacpp.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.auto.service</groupId>
      <artifactId>auto-service-annotations</artifactId>
      <version>1.1.1</version>
    </dependency>
    <dependency>
      <groupId>com.google.auto.service</groupId>
      <artifactId>auto-service</artifactId>
      <version>1.1.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.ejml</groupId>
      <artifactId>ejml-all</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>hdf5</artifactId>
      <version>${hdf5.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacv</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>opencv</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jzy3d</groupId>
      <artifactId>jzy3d-core</artifactId>
      <version>2.2.2-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.jzy3d</groupId>
      <artifactId>jzy3d-native-jogl-javafx</artifactId>
      <version>2.2.2-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.jzy3d</groupId>
      <artifactId>jzy3d-native-jogl-awt</artifactId>
      <version>2.2.2-SNAPSHOT</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <fork>false</fork>
          <compilerArgs>
            <arg>--add-modules</arg>
            <arg>jdk.incubator.vector</arg>
            <arg>-Xpkginfo:always</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.auto.service</groupId>
              <artifactId>auto-service</artifactId>
              <version>${auto-service.version}</version>
            </path>
          </annotationProcessorPaths>
          <excludes>
            <exclude>${cuda.exclude.1}</exclude>
            <exclude>${cuda.exclude.2}</exclude>
            <exclude>${cuda.exclude.3}</exclude>
            <exclude>${la.native.exclude.1}</exclude>
            <exclude>${la.native.exclude.2}</exclude>
            <exclude>module-info.java</exclude>
            <exclude>**/NativeOpenCLFFTBackend.java</exclude>
          </excludes>
          <testExcludes>
            <exclude>${cuda.exclude.1}</exclude>
            <exclude>${cuda.exclude.2}</exclude>
            <exclude>${cuda.exclude.3}</exclude>
            <exclude>${la.native.exclude.1}</exclude>
            <exclude>${la.native.exclude.2}</exclude>
            <exclude>**/NativeOpenCLTest.java</exclude>
            <exclude>**/NativeOpenCLFFTTest.java</exclude>
            <exclude>**/NativeHardeningStressTest.java</exclude>
            <exclude>**/NativeCUDADenseLinearAlgebraBackendTest.java</exclude>
            <exclude>**/NativeOpenCLDenseLinearAlgebraBackendTest.java</exclude>
            <exclude>**/NativeCUDASparseLinearAlgebraBackendTest.java</exclude>
            <exclude>**/NativeOpenCLSparseLinearAlgebraBackendTest.java</exclude>
            <exclude>**/Native*VisionBackendTest.java</exclude>
          </testExcludes>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>1</forkCount>
          <reuseForks>false</reuseForks>
          <argLine>--add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <episteme.benchmark.skip>true</episteme.benchmark.skip>
            <episteme.nd4j.skip>false</episteme.nd4j.skip>
            <episteme.jblas.skip>false</episteme.jblas.skip>
            <org.jblas.util.LibraryLoader.deletedll>false</org.jblas.util.LibraryLoader.deletedll>
            <java.awt.headless>true</java.awt.headless>
          </systemPropertyVariables>
          <environmentVariables>
            <AWT_TOOLKIT>headless</AWT_TOOLKIT>
          </environmentVariables>
          <excludes>
            <exclude>${cuda.exclude.1}</exclude>
            <exclude>${cuda.exclude.2}</exclude>
            <exclude>${cuda.exclude.3}</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.11</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>jcuda-linux-x86_64</id>
      <activation>
        <os>
          <name>linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <la.native.exclude.1>none</la.native.exclude.1>
        <cuda.exclude.1>none</cuda.exclude.1>
        <cuda.exclude.2>none</cuda.exclude.2>
        <la.native.exclude.2>none</la.native.exclude.2>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.jcuda</groupId>
          <artifactId>jcuda</artifactId>
          <version>${jcuda.version}</version>
        </dependency>
        <dependency>
          <groupId>org.jcuda</groupId>
          <artifactId>jcublas</artifactId>
          <version>${jcuda.version}</version>
        </dependency>
        <dependency>
          <groupId>org.jcuda</groupId>
          <artifactId>jcusparse</artifactId>
          <version>${jcuda.version}</version>
        </dependency>
        <dependency>
          <groupId>org.jcuda</groupId>
          <artifactId>jcuda-natives</artifactId>
          <version>${jcuda.version}</version>
          <classifier>linux-x86_64</classifier>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>jcuda-windows-x86_64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <la.native.exclude.1>none</la.native.exclude.1>
        <cuda.exclude.1>none</cuda.exclude.1>
        <cuda.exclude.2>none</cuda.exclude.2>
        <la.native.exclude.2>none</la.native.exclude.2>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.jcuda</groupId>
          <artifactId>jcuda</artifactId>
          <version>${jcuda.version}</version>
        </dependency>
        <dependency>
          <groupId>org.jcuda</groupId>
          <artifactId>jcublas</artifactId>
          <version>${jcuda.version}</version>
        </dependency>
        <dependency>
          <groupId>org.jcuda</groupId>
          <artifactId>jcusparse</artifactId>
          <version>${jcuda.version}</version>
        </dependency>
        <dependency>
          <groupId>org.jcuda</groupId>
          <artifactId>jcuda-natives</artifactId>
          <version>${jcuda.version}</version>
          <classifier>windows-x86_64</classifier>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>opencl</id>
      <properties>
        <la.native.exclude.2>none</la.native.exclude.2>
      </properties>
    </profile>
    <profile>
      <id>openblas</id>
      <properties>
        <blas.library>openblas</blas.library>
      </properties>
    </profile>
    <profile>
      <id>optimal</id>
      <dependencies>
        <dependency>
          <groupId>org.bytedeco</groupId>
          <artifactId>openblas-platform</artifactId>
          <version>${openblas.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>benchmark</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.bytedeco</groupId>
          <artifactId>openblas-platform</artifactId>
          <version>${openblas.version}</version>
        </dependency>
        <dependency>
          <groupId>org.bytedeco</groupId>
          <artifactId>arrow-platform</artifactId>
          <version>${arrow.version}</version>
        </dependency>
        <dependency>
          <groupId>org.bytedeco</groupId>
          <artifactId>fftw-platform</artifactId>
          <version>3.3.10-${javacpp.version}</version>
        </dependency>
        <dependency>
          <groupId>org.bytedeco</groupId>
          <artifactId>hdf5-platform</artifactId>
          <version>${hdf5.version}</version>
        </dependency>
        <dependency>
          <groupId>org.bytedeco</groupId>
          <artifactId>javacv-platform</artifactId>
          <version>${javacpp.version}</version>
        </dependency>
        <dependency>
          <groupId>org.bytedeco</groupId>
          <artifactId>opencv-platform</artifactId>
          <version>${opencv.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>mkl</id>
      <properties>
        <blas.library>mkl_rt</blas.library>
      </properties>
    </profile>
    <profile>
      <id>no-cuda</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <cuda.exclude.3>org/episteme/nativ/technical/backend/gpu/cuda/**</cuda.exclude.3>
        <cuda.exclude.1>**/*CUDA*</cuda.exclude.1>
        <cuda.exclude.2>**/*Cuda*</cuda.exclude.2>
      </properties>
    </profile>
    <profile>
      <id>no-cuda-arm</id>
      <activation>
        <os>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <cuda.exclude.3>org/episteme/nativ/technical/backend/gpu/cuda/**</cuda.exclude.3>
        <cuda.exclude.1>**/*CUDA*</cuda.exclude.1>
        <cuda.exclude.2>**/*Cuda*</cuda.exclude.2>
      </properties>
    </profile>
  </profiles>
</project>

